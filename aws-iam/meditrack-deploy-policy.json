{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediTrackServicesDuProjet",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "s3:*",
        "cloudfront:*",
        "ecr:*",
        "ecs:*",
        "rds:*",
        "elasticloadbalancing:*",
        "logs:*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudwatch:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretRDSUniquement",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:eu-west-3:971598352115:secret:rds!*"
    },
    {
      "Sid": "ChiffrementViaRDSEtSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "rds.eu-west-3.amazonaws.com",
            "secretsmanager.eu-west-3.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "RolesIAMDuProjetUniquement",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::971598352115:role/meditrack-*"
    },
    {
      "Sid": "PassageDuRoleAECSUniquement",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::971598352115:role/meditrack-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    },
    {
      "Sid": "RolesLiesAuxServicesAWS",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ConsoleTemporairePourLesCaptures",
      "Effect": "Allow",
      "Action": "sts:GetFederationToken",
      "Resource": "arn:aws:sts::971598352115:federated-user/meditrack-*"
    }
  ]
}
